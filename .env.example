APP_NAME="Tourism Survey"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=daily

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=survey
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

MAIL_ADMIN_NAME="Admin"
MAIL_ADMIN_EMAIL=""

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

RECAPTCHAV2_SITEKEY=<yoursitekeyhere>
RECAPTCHAV2_SECRET=<yoursecrethere>

TELESCOPE_ENABLED=false

TEST_EMAIL="youremail@gmail.com"

# The branch that's work for this instance app
BRANCH_DEPLOY=production
# Using Submodule or not 0 for not, 1 for yes
USING_SUBMODULE=0

ONESIGNAL_REST_API_URL=https://api.onesignal.com
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

SENANGPAY_MERCHANT_ID=
SENANGPAY_SECRET_KEY=

SEAFEST_SENANGPAY_MERCHANT_ID=
SEAFEST_SENANGPAY_SECRET_KEY=

BYPASS_OTP=7777

# For production, change the base_url and verify_url
# SENANGPAY_BASE_URL=https://app.senangpay.my/apiv2/
# SENANGPAY_VERIFY_URL=https://app.senangpay.my/apiv2/querytransaction/

# Feature Flags
# Set to true to bypass approval flow (3-step: create -> payment -> print)
# Set to false for normal flow (5-step: create -> payment -> authorities -> jetty -> print)
BYPASS_APPROVAL_FLOW=false
