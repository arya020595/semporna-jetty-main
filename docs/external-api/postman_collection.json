{
	"info": {
		"name": "Semporna Jetty \u2014 External Partner API",
		"description": "Read-only reference-data endpoints exposed to external partner systems (currently the Semporna Jetty Resort Manifest Form). See docs/external-api/openapi.yaml in the same repo for the full contract, and App\\Http\\Controllers\\Api\\External\\{Destination,Activity,Nationality,Boat,Boatman}Controller for the implementation.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{external_api_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "external_api_token",
			"value": "c2871b190dd64a01e916702b286964a10fb5481644855e1ef81cf140ac0c8080",
			"type": "string",
			"description": "Local-dev default matching .env.example's EXTERNAL_API_TOKEN, so requests work out of the box against a fresh local install. Override for staging/production \u2014 never commit a real production token here."
		}
	],
	"item": [
		{
			"name": "List Destinations",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/external/destinations",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"external",
						"destinations"
					]
				},
				"description": "Returns every active destination (type = TYPE_DESTINATION only \u2014 departure/jetty points are excluded), for populating the Resort Manifest Form's \"To\" dropdown. No pagination, no query params."
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('success is true', function () {",
							"    pm.expect(pm.response.json().success).to.be.true;",
							"});",
							"",
							"pm.test('data is an array of destinations', function () {",
							"    const body = pm.response.json();",
							"    pm.expect(body.data).to.be.an('array');",
							"    if (body.data.length > 0) {",
							"        pm.expect(body.data[0]).to.have.all.keys('id', 'code', 'title');",
							"    }",
							"});"
						]
					}
				}
			],
			"response": [
				{
					"name": "200 OK",
					"originalRequest": {
