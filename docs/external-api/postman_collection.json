{
	"info": {
		"name": "Semporna Jetty — External Partner API",
		"description": "Read-only reference-data endpoints exposed to external partner systems (currently the Semporna Jetty Resort Manifest Form). See docs/external-api/openapi.yaml in the same repo for the full contract, and App\\Http\\Controllers\\Api\\External\\{Destination,Activity}Controller for the implementation.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{external_api_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "external_api_token",
			"value": "c2871b190dd64a01e916702b286964a10fb5481644855e1ef81cf140ac0c8080",
			"type": "string",
			"description": "Local-dev default matching .env.example's EXTERNAL_API_TOKEN, so requests work out of the box against a fresh local install. Override for staging/production — never commit a real production token here."
		}
	],
	"item": [
		{
			"name": "List Destinations",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/external/destinations",
					"host": ["{{base_url}}"],
					"path": ["api", "external", "destinations"]
				},
				"description": "Returns every active destination (type = TYPE_DESTINATION only — departure/jetty points are excluded), for populating the Resort Manifest Form's \"To\" dropdown. No pagination, no query params."
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('success is true', function () {",
							"    pm.expect(pm.response.json().success).to.be.true;",
							"});",
							"",
							"pm.test('data is an array of destinations', function () {",
							"    const body = pm.response.json();",
							"    pm.expect(body.data).to.be.an('array');",
							"    if (body.data.length > 0) {",
							"        pm.expect(body.data[0]).to.have.all.keys('id', 'code', 'title');",
							"    }",
							"});"
						]
					}
				}
			],
			"response": [
				{
					"name": "200 OK",
					"originalRequest": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{base_url}}/api/external/destinations",
							"host": ["{{base_url}}"],
							"path": ["api", "external", "destinations"]
						}
					},
					"status": "OK",
					"code": 200,
					"header": [{ "key": "Content-Type", "value": "application/json" }],
					"body": "{\n  \"success\": true,\n  \"message\": \"List Destinations\",\n  \"data\": [\n    { \"id\": 1, \"code\": \"DEST_00001\", \"title\": \"Mataking\" },\n    { \"id\": 2, \"code\": \"DEST_00002\", \"title\": \"Bohey Dulang\" },\n    { \"id\": 3, \"code\": \"DEST_00003\", \"title\": \"Gusungan\" },\n    { \"id\": 4, \"code\": \"DEST_00004\", \"title\": \"Sibuan\" },\n    { \"id\": 5, \"code\": \"DEST_00005\", \"title\": \"Pom-Pom\" }\n  ]\n}"
				},
				{
					"name": "401 Unauthorized",
					"originalRequest": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer wrong-token" }
						],
						"url": {
							"raw": "{{base_url}}/api/external/destinations",
							"host": ["{{base_url}}"],
							"path": ["api", "external", "destinations"]
						}
					},
					"status": "Unauthorized",
					"code": 401,
					"header": [{ "key": "Content-Type", "value": "application/json" }],
					"body": "{\n  \"success\": false,\n  \"message\": \"Unauthorized.\",\n  \"data\": null\n}"
				}
			]
		},
		{
			"name": "List Activities",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/external/activities",
					"host": ["{{base_url}}"],
					"path": ["api", "external", "activities"]
				},
				"description": "Returns every active activity, for populating the Resort Manifest Form's \"Activity\" dropdown. No pagination, no query params, no type filter."
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('success is true', function () {",
							"    pm.expect(pm.response.json().success).to.be.true;",
							"});",
							"",
							"pm.test('data is an array of activities', function () {",
							"    const body = pm.response.json();",
							"    pm.expect(body.data).to.be.an('array');",
							"    if (body.data.length > 0) {",
							"        pm.expect(body.data[0]).to.have.all.keys('id', 'code', 'title');",
							"    }",
							"});"
						]
					}
				}
			],
			"response": [
				{
					"name": "200 OK",
					"originalRequest": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{base_url}}/api/external/activities",
							"host": ["{{base_url}}"],
							"path": ["api", "external", "activities"]
						}
					},
					"status": "OK",
					"code": 200,
					"header": [{ "key": "Content-Type", "value": "application/json" }],
					"body": "{\n  \"success\": true,\n  \"message\": \"List Activities\",\n  \"data\": [\n    { \"id\": 1, \"code\": \"ACT_00001\", \"title\": \"Snorkeling\" },\n    { \"id\": 2, \"code\": \"ACT_00002\", \"title\": \"Fun Dive/Diving\" },\n    { \"id\": 3, \"code\": \"ACT_00003\", \"title\": \"Free Diving\" },\n    { \"id\": 4, \"code\": \"ACT_00004\", \"title\": \"Accommodation\" },\n    { \"id\": 5, \"code\": \"ACT_00005\", \"title\": \"IDC\" }\n  ]\n}"
				},
				{
					"name": "401 Unauthorized",
					"originalRequest": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer wrong-token" }
						],
						"url": {
							"raw": "{{base_url}}/api/external/activities",
							"host": ["{{base_url}}"],
							"path": ["api", "external", "activities"]
						}
					},
					"status": "Unauthorized",
					"code": 401,
					"header": [{ "key": "Content-Type", "value": "application/json" }],
					"body": "{\n  \"success\": false,\n  \"message\": \"Unauthorized.\",\n  \"data\": null\n}"
				}
			]
		}
	]
}
