                "isDate": ":attribute mesti tarikh yang sah.",
                "isDistinct": ":attribute mesti berbeza.",
                "isEmail": ":attribute mesti emel yang sah.",
                "isExtension": ":attribute mesti fail jenis :extensions.",
                "isGt": ":attribute mesti lebih besar daripada :otherValue.",
                "isGte": ":attribute mesti lebih besar atau sama dengan :otherValue.",
                "isImage": ":attribute mesti imej.",
                "isIn": ":attribute mesti salah satu daripada :options.",
                "isInteger": ":attribute mesti integer.",
                "isIp": ":attribute mesti alamat IP yang sah.",
                "isJSON": ":attribute mesti JSON yang sah.",
                "isLt": ":attribute mesti kurang daripada :otherValue.",
                "isLte": ":attribute mesti kurang atau sama dengan :otherValue.",
                "isMax": ":attribute mesti paling banyak :max.",
                "isMax.string": ":attribute mesti paling banyak :max aksara.",
                "isMax.array": ":attribute mesti mempunyai paling banyak :max item.",
                "isMax.file": ":attribute mesti paling banyak :maxMB.",
                "isMime": ":attribute mesti fail jenis :mimes.",
                "isMin": ":attribute mesti sekurang-kurangnya :min.",
                "isMin.string": ":attribute mesti sekurang-kurangnya :min aksara.",
                "isMin.array": ":attribute mesti sekurang-kurangnya :min item.",
                "isMin.file": ":attribute mesti sekurang-kurangnya :minMB.",
                "isNotIn": ":attribute tidak boleh salah satu daripada :options.",
                "isNotRegex": ":attribute tidak boleh memadankan regex :regex.",
                "isNumeric": ":attribute mesti nombor.",
                "isRegex": ":attribute mesti memadankan regex :regex.",
                "isRequired": ":attribute diperlukan.",
                "isRequiredIf": ":attribute diperlukan jika :other adalah :otherValue.",
                "isRequiredIfAccepted": ":attribute diperlukan jika :other diterima.",
                "isRequiredUnless": ":attribute diperlukan melainkan :other adalah :otherValue.",
                "isRequiredWith": ":attribute diperlukan apabila :others ada.",
                "isRequiredWithAll": ":attribute diperlukan apabila :others ada.",
                "isRequiredWithout": ":attribute diperlukan apabila :others tiada.",
                "isRequiredWithoutAll": ":attribute diperlukan apabila :others tiada.",
                "isSame": ":attribute mesti sama dengan :other.",
                "isUrl": ":attribute mesti URL yang sah."
